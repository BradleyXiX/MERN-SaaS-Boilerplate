# ====================
# Server Configuration
# ====================
NODE_ENV=development
PORT=5000

# ====================
# Database Configuration
# ====================
MONGO_URI=mongodb://localhost:27017/saas
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ====================
# JWT Configuration
# ====================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this_in_production
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ====================
# Email Configuration
# ====================
# Email service is optional - if not configured, emails will be logged to console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=false

# For Gmail:
# 1. Enable 2-Factor Authentication
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the generated 16-character password as SMTP_PASS
# 4. SMTP_USER should be your full Gmail address

# For other providers, update SMTP_HOST and SMTP_PORT accordingly
# Common providers:
# - Office 365: smtp.office365.com:587
# - SendGrid: smtp.sendgrid.net:587 (use 'apikey' as user)
# - Mailgun: smtp.mailgun.org:587
